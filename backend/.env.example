# Application
PORT=4000
CLIENT_ORIGIN=http://localhost:7904
# Development only; use a random 32+ character secret in production.
JWT_SECRET=change-this-secret
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# PayMongo hosted checkout
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_API_URL=https://api.paymongo.com

# Database
# Local development defaults. Railway can provide MYSQL_URL or MYSQLHOST,
# MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, and MYSQLDATABASE from its MySQL service.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cocolyntiks
DB_SSL=false
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=50

# Email / OTP delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=COCOLYTICS

# Use a Google app password, not your normal Gmail password.
# Enable 2-Step Verification first, then create an app password at:
# https://myaccount.google.com/apppasswords

# Optional phone signup and SMS OTP delivery (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Configure one sender option:
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
