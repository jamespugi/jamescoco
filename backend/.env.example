# Application
PORT=4000
CLIENT_ORIGIN=http://localhost:7904
# Development only; use a unique random 32+ character secret in production.
JWT_SECRET=4fe95a6c35ff99846fba474f37cd474f67a92fa0fe1a03d2198fd17cbe509f93d58128c842513b29d08846111ff64aaf
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# PayMongo hosted checkout
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_API_URL=https://api.paymongo.com

# Database
# Local development defaults. For Dokploy, set DB_HOST to the actual private
# hostname supplied by the MySQL service; this project does not define a MYSQL host.
DB_HOST=cocolytics-database-drenvm
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_ALLOW_EMPTY_PASSWORD=true
DB_NAME=cocolyntiks
DB_SSL=false
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=50

# Email / OTP delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=COCOLYTICS

# Use a Google app password, not your normal Gmail password.
# Enable 2-Step Verification first, then create an app password at:
# https://myaccount.google.com/apppasswords

# Optional phone signup and SMS OTP delivery (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Configure one sender option:
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
