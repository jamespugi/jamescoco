# Copy these settings into Dokploy's application environment or its root .env.
NODE_ENV=production
PORT=5000
CLIENT_ORIGIN=https://your-public-domain.example
JWT_SECRET=replace-with-a-new-random-secret

# Use the private hostname and credentials from your Dokploy MySQL service.
DB_HOST=your-private-mysql-host
DB_PORT=3306
DB_NAME=cocolyntiks
DB_USER=your-mysql-user
DB_PASSWORD=replace-with-your-mysql-password
DB_SSL=false
