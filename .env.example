# Copy these settings into Dokploy's application environment or its root .env.
NODE_ENV=production
PORT=5000
CLIENT_ORIGIN=https://your-public-domain.example
JWT_SECRET=replace-with-a-new-random-secret
# Generate a random 32+ character code and keep it only in the Dokploy environment.
# Admin signup is available once per database after this value is configured.
ADMIN_SIGNUP_CODE=

# Use the private hostname and credentials from your Dokploy MySQL service.
DB_HOST=cocolytics-database-drenvm
DB_PORT=3306
DB_NAME=cocolyntiks
DB_USER=root
DB_PASSWORD=
DB_ALLOW_EMPTY_PASSWORD=true
DB_SSL=false
